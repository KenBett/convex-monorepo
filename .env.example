CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=
# Derived from NEXT_PUBLIC_CONVEX_URL by replacing .convex.cloud with .convex.site
# Used for the /voice/turn streaming endpoint.
NEXT_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_CONVEX_URL=

# Convex Auth — set in Convex dashboard via: bunx convex env set <NAME> <value>
SITE_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Buyer chat narration (Next.js /api/buyer/sourcing). Use the same key as Convex OpenAI.
OPENAI_API_KEY=

# M-PESA Daraja (set in Convex via: bunx convex env set <NAME> <value>)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_ENV=sandbox
# Callback URL for Safaricom dashboard: {CONVEX_SITE_URL}/api/webhooks/mpesa/stk

NEXT_PUBLIC_APP_URL=http://localhost:3000
